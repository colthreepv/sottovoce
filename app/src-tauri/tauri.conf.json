{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sottovoce",
  "version": "0.2.0",
  "identifier": "com.colthreepv.sottovoce",
  "build": {
    "beforeDevCommand": "bun run --cwd ../ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run --cwd ../ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Sottovoce", "width": 1100, "height": 740, "minWidth": 800, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; media-src asset: http://asset.localhost; img-src 'self' data:",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": { "active": false, "icon": [] }
}
